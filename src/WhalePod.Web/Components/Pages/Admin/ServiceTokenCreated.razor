@page "/admin/service-accounts/tokens/created"
@layout AdminLayout
@attribute [Authorize(Policy = "AdminOnly")]
@using System.Security.Claims
@using WhalePod.Infrastructure.Services
@using WhalePod.Web.Services
@inject ServiceTokenRevealCache RevealCache
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>令牌已创建 - WhalePod</PageTitle>

<h1>令牌已创建</h1>


@if (Token is null)
{
    <p role="alert">令牌明文只显示一次，当前没有可展示的令牌。请在服务账号详情页重新签发或轮换。</p>
}
else
{
    <p role="status">请立即复制令牌并保存到本机秘密存储。离开本页后无法再次查看。</p>

    <p>
        <code id="service-token">@Token.PlaintextToken</code>
        <button type="button" data-copy-target="service-token">复制令牌</button>
    </p>
    <noscript><p>浏览器未启用脚本时，请手动选择上方令牌复制。</p></noscript>

    <dl>
        <dt>服务账号</dt>
        <dd>@Token.AccountName</dd>
        <dt>前缀</dt>
        <dd>@Token.Prefix…</dd>
        <dt>过期时间（北京时间）</dt>
        <dd>@DisplayFormat.Time(Token.ExpiresAt)</dd>
        <dt>创建时间（北京时间）</dt>
        <dd>@DisplayFormat.Time(Token.CreatedAt)</dd>
    </dl>

    <p>数据库只保存 SHA-256 哈希；令牌不得写入 URL、日志或前端存储。</p>
    <p><a href="/admin/service-accounts/@Token.AccountId">返回服务账号详情</a></p>
}

<p><a href="/admin/service-accounts">返回服务账号列表</a></p>

@code {
    private ServiceTokenCreationData? Token { get; set; }

    protected override void OnInitialized()
    {
        var httpContext = HttpContextAccessor.HttpContext
            ?? throw new InvalidOperationException("HttpContext is unavailable.");

        if (Guid.TryParse(httpContext.User.FindFirstValue(ClaimTypes.NameIdentifier), out var adminId))
        {
            Token = RevealCache.Take(adminId);
        }
    }
}
