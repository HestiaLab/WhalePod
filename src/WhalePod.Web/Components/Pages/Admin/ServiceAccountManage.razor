@page "/admin/service-accounts/{AccountId:guid}"
@layout AdminLayout
@attribute [Authorize(Policy = "AdminOnly")]
@using Microsoft.AspNetCore.Antiforgery
@using WhalePod.Infrastructure.Services
@inject ServiceAccountAdminService ServiceAccounts
@inject AiSettingsService AiSettings
@inject AiBudgetService AiBudget
@inject IAntiforgery Antiforgery
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>服务账号详情 - WhalePod</PageTitle>

<h1>服务账号详情</h1>
<p class="masthead-lead">服务账号的预算、令牌与停用状态；令牌明文只显示一次。</p>


<p><a href="/admin/service-accounts">返回服务账号列表</a></p>

@if (MessageText is not null)
{
    <p role="status">@MessageText</p>
}

@if (ErrorText is not null)
{
    <p role="alert">@ErrorText</p>
}

@if (Detail is null)
{
    <p role="alert">服务账号不存在。</p>
}
else
{
    <dl>
        <dt>名称</dt>
        <dd>@Detail.Account.Name</dd>
        <dt>所有者</dt>
        <dd>@Detail.Account.OwnerHandle</dd>
        <dt>状态</dt>
        <dd>@(Detail.Account.Status == "active" ? "启用" : "已停用")</dd>
        <dt>scope</dt>
        <dd>@string.Join(", ", Detail.Account.Scopes)</dd>
        <dt>IP allowlist</dt>
        <dd>@(Detail.Account.IpAllowlist.Count == 0 ? "未限制" : string.Join(", ", Detail.Account.IpAllowlist))</dd>
        <dt>创建时间（北京时间）</dt>
        <dd>@DisplayFormat.Time(Detail.Account.CreatedAt)</dd>
        <dt>停用时间（北京时间）</dt>
        <dd>@DisplayFormat.Time(Detail.Account.DisabledAt)</dd>
    </dl>

    <section aria-labelledby="account-budget-heading">
        <h2 id="account-budget-heading">每日 token 预算覆盖</h2>
        <dl>
            <dt>站点默认预算</dt>
            <dd>@(Settings?.DailyTokenBudget.ToString() ?? "—")</dd>
            <dt>账号覆盖预算</dt>
            <dd>@(Detail.Account.DailyTokenBudget?.ToString() ?? "未覆盖（使用站点默认）")</dd>
            @if (Usage is not null)
            {
                <dt>今日已用 token（UTC 日）</dt>
                <dd>@Usage.UsedTokensToday / @(Detail.Account.DailyTokenBudget ?? Settings?.DailyTokenBudget)</dd>
                <dt>今日建议数</dt>
                <dd>@Usage.TodaySuggestionCount</dd>
                <dt>超限状态</dt>
                <dd>@(Usage.BudgetExceeded ? "已超限，claim/suggestion 返回 429" : "未超限")</dd>
                <dt>预算重置时间（UTC）</dt>
                <dd>@Usage.ResetsAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm")</dd>
            }
        </dl>
        <form method="post" action="/admin/service-accounts/@AccountId/budget">
            <input type="hidden" name="__RequestVerificationToken" value="@Token" />
            <p>
                <label for="account-daily-budget">覆盖预算（留空使用站点默认）</label>
                <input id="account-daily-budget" name="dailyTokenBudget" type="number"
                       min="1" max="1000000000" value="@Detail.Account.DailyTokenBudget" />
            </p>
            <button type="submit">保存预算覆盖</button>
        </form>
        <p class="muted">覆盖只限制该服务账号当日建议的 token 用量；站点级预算和其他账号预算仍独立生效。</p>
    </section>

    @if (Detail.Account.Status == "active")
    {
        <section aria-labelledby="issue-token-heading">
            <h2 id="issue-token-heading">签发令牌</h2>
            <form method="post" action="/admin/service-accounts/@AccountId/tokens/issue">
                <input type="hidden" name="__RequestVerificationToken" value="@Token" />
                <p>
                    <label for="issue-days">有效期（天，1-365）</label>
                    <input id="issue-days" name="days" type="number" min="1" max="365" value="90" required />
                </p>
                <p>
                    <label>
                        <input type="checkbox" name="confirmIssue" value="true" required />
                        我确认生成一次性令牌；明文只显示一次
                    </label>
                </p>
                <button type="submit">签发令牌</button>
            </form>
        </section>

        <section aria-labelledby="rotate-token-heading">
            <h2 id="rotate-token-heading">轮换令牌</h2>
            <form method="post" action="/admin/service-accounts/@AccountId/tokens/rotate">
                <input type="hidden" name="__RequestVerificationToken" value="@Token" />
                <p>
                    <label for="rotate-days">新令牌有效期（天，1-365）</label>
                    <input id="rotate-days" name="days" type="number" min="1" max="365" value="90" required />
                </p>
                <p>
                    <label>
                        <input type="checkbox" name="confirmRotate" value="true" required />
                        我确认轮换会立即撤销该账号所有现有令牌
                    </label>
                </p>
                <button type="submit">轮换令牌</button>
            </form>
        </section>

        <section aria-labelledby="disable-account-heading">
            <h2 id="disable-account-heading">停用服务账号</h2>
            <form method="post" action="/admin/service-accounts/@AccountId/disable">
                <input type="hidden" name="__RequestVerificationToken" value="@Token" />
                <p>
                    <label>
                        <input type="checkbox" name="confirmDisable" value="true" required />
                        我确认停用账号并立即撤销所有有效令牌
                    </label>
                </p>
                <button type="submit" class="button-danger">停用服务账号</button>
            </form>
        </section>
    }

    <section aria-labelledby="token-list-heading">
        <h2 id="token-list-heading">令牌</h2>
        @if (Detail.Tokens.Count == 0)
        {
            <p>暂无令牌。</p>
        }
        else
        {
            <div class="table-scroll" tabindex="0" role="region" aria-label="服务账号令牌">
                <table class="admin-token-table">
                    <caption>令牌只显示前缀；明文只在签发/轮换时展示一次。</caption>
                    <thead>
                        <tr>
                            <th scope="col">前缀</th>
                            <th scope="col">状态</th>
                            <th scope="col">创建时间</th>
                            <th scope="col">过期时间</th>
                            <th scope="col">最后使用</th>
                            <th scope="col">撤销</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var token in Detail.Tokens)
                        {
                            <tr>
                                <td><code>@token.Prefix…</code></td>
                                <td>@TokenStatus(token)</td>
                                <td>@DisplayFormat.Time(token.CreatedAt)</td>
                                <td>@DisplayFormat.Time(token.ExpiresAt)</td>
                                <td>@DisplayFormat.Time(token.LastUsedAt)</td>
                                <td>
                                    @if (IsActiveToken(token))
                                    {
                                        <form method="post" action="/admin/service-accounts/@AccountId/tokens/@token.Id/revoke">
                                            <input type="hidden" name="__RequestVerificationToken" value="@Token" />
                                            <label>
                                                <input type="checkbox" name="confirmRevoke" value="true" required />
                                                确认撤销
                                            </label>
                                            <button type="submit" class="button-danger">撤销</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}

@code {
    [Parameter]
    public Guid AccountId { get; set; }

    [SupplyParameterFromQuery]
    public string? Message { get; set; }

    [SupplyParameterFromQuery]
    public string? Error { get; set; }

    private ServiceAccountDetail? Detail { get; set; }
    private AiSettingsData? Settings { get; set; }
    private AiAccountBudgetStatus? Usage { get; set; }
    private string Token { get; set; } = string.Empty;

    private string? MessageText => Message switch
    {
        "disabled" => "服务账号已停用，所有有效令牌已撤销。",
        "revoked" => "令牌已撤销。",
        "budget" => "服务账号预算覆盖已保存。",
        "unchanged" => "没有需要变更的内容。",
        _ => null
    };

    private string? ErrorText => Error switch
    {
        "confirm" => "请确认所选敏感操作。",
        "disabled" => "服务账号已停用，不能签发或轮换令牌。",
        "invalid" => "操作参数无效，请检查有效期。",
        "not-found" => "令牌不存在。",
        "budget" => "服务账号预算必须在 1 到 1,000,000,000 之间，或留空。",
        _ => null
    };

    protected override async Task OnInitializedAsync()
    {
        var httpContext = HttpContextAccessor.HttpContext
            ?? throw new InvalidOperationException("HttpContext is unavailable.");

        Token = Antiforgery.GetAndStoreTokens(httpContext).RequestToken
            ?? throw new InvalidOperationException("Unable to issue an antiforgery token.");

        Detail = await ServiceAccounts.GetDetailAsync(AccountId);
        if (Detail is null)
        {
            StatusCodeResponse.NotFound(httpContext);
            return;
        }

        Settings = await AiSettings.GetAsync(httpContext.RequestAborted);
        Usage = await AiBudget.GetAccountStatusAsync(AccountId, httpContext.RequestAborted);
    }

    private static bool IsActiveToken(ServiceTokenListItem token)
    {
        return token.RevokedAt is null && token.ExpiresAt > DateTimeOffset.UtcNow;
    }

    private static string TokenStatus(ServiceTokenListItem token)
    {
        if (token.RevokedAt is not null)
        {
            return "已撤销";
        }

        return token.ExpiresAt <= DateTimeOffset.UtcNow ? "已过期" : "有效";
    }
}
