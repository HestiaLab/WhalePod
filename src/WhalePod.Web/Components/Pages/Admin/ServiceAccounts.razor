@page "/admin/service-accounts"
@layout AdminLayout
@attribute [Authorize(Policy = "AdminOnly")]
@using Microsoft.AspNetCore.Antiforgery
@using WhalePod.Infrastructure.Services
@inject ServiceAccountAdminService ServiceAccountAdmin
@inject IAntiforgery Antiforgery
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>服务账号 - WhalePod</PageTitle>

<h1>服务账号</h1>


<p>
    <a href="/">返回首页</a> ·
    <a href="/admin/ai">AI 开关</a>
</p>

@if (ErrorText is not null)
{
    <p role="alert">@ErrorText</p>
}

<section aria-labelledby="create-service-account-heading">
    <h2 id="create-service-account-heading">创建服务账号</h2>
    <form method="post" action="/admin/service-accounts/create">
        <input type="hidden" name="__RequestVerificationToken" value="@Token" />
        <p>
            <label for="account-name">名称（1-80 字）</label><br />
            <input id="account-name" name="name" maxlength="80" required />
        </p>
        <fieldset>
            <legend>最小 scope</legend>
            @foreach (var scope in ServiceAccountAdminService.AllowedScopes)
            {
                <p>
                    <input id="scope-@scope" type="checkbox" name="scopes" value="@scope" />
                    <label for="scope-@scope">@scope</label>
                </p>
            }
        </fieldset>
        <p>
            <label for="ip-allowlist">IP allowlist（可选，每行一个 IP，不支持 CIDR）</label><br />
            <textarea id="ip-allowlist" name="ipAllowlist" rows="3" maxlength="1000"></textarea>
        </p>
        <button type="submit">创建服务账号</button>
    </form>
</section>

<section aria-labelledby="service-account-list-heading">
    <h2 id="service-account-list-heading">现有服务账号</h2>

    @if (Accounts.Count == 0)
    {
        <div class="empty-state">暂无服务账号。</div>
    }
    else
    {
        <div class="table-scroll" tabindex="0" role="region" aria-label="服务账号列表">
            <table class="admin-service-account-table">
                <caption>服务账号不能交互式登录；令牌明文只显示一次。</caption>
                <thead>
                    <tr>
                        <th scope="col">名称</th>
                        <th scope="col">所有者</th>
                        <th scope="col">状态</th>
                        <th scope="col">scope</th>
                        <th scope="col">IP</th>
                        <th scope="col">令牌</th>
                        <th scope="col">创建时间</th>
                        <th scope="col">最后使用</th>
                        <th scope="col">详情</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var account in Accounts)
                    {
                        <tr>
                            <td>@account.Name</td>
                            <td>@account.OwnerHandle</td>
                            <td>@(account.Status == "active" ? "启用" : "已停用")</td>
                            <td>@string.Join(", ", account.Scopes)</td>
                            <td>@(account.IpAllowlist.Count == 0 ? "—" : string.Join(", ", account.IpAllowlist))</td>
                            <td>@account.ActiveTokens / @account.TotalTokens 有效</td>
                            <td>@DisplayFormat.Time(account.CreatedAt)</td>
                            <td>@DisplayFormat.Time(account.LastUsedAt)</td>
                            <td><a href="/admin/service-accounts/@account.Id">管理</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    [SupplyParameterFromQuery]
    public string? Error { get; set; }

    private IReadOnlyList<ServiceAccountListItem> Accounts { get; set; } = [];
    private string Token { get; set; } = string.Empty;

    private string? ErrorText => Error switch
    {
        "duplicate" => "服务账号名称已存在。",
        "invalid" => "服务账号参数无效，请检查名称、scope 与 IP。",
        _ => null
    };

    protected override async Task OnInitializedAsync()
    {
        var httpContext = HttpContextAccessor.HttpContext
            ?? throw new InvalidOperationException("HttpContext is unavailable.");

        Token = Antiforgery.GetAndStoreTokens(httpContext).RequestToken
            ?? throw new InvalidOperationException("Unable to issue an antiforgery token.");
        Accounts = await ServiceAccountAdmin.ListAsync();
    }
}
