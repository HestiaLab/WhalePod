{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "WebWriteRateLimit": {
    "PermitLimit": 60,
    "WindowSeconds": 60
  },
  "WebRequestLimits": {
    "MaxFormBodyBytes": 2097152
  },
  "InviteRedeemRateLimit": {
    "PermitLimit": 10,
    "WindowSeconds": 60
  },
  "PublicSearch": {
    "RateLimitPerMinute": 30,
    "TimeoutSeconds": 3
  },
  "DeviceVerification": {
    "MaxActiveDevices": 5,
    "ChallengeTtlSeconds": 300,
    "TimestampSkewSeconds": 300,
    "MaxFailedAttempts": 5,
    "FailureWindowSeconds": 600,
    "LockoutSeconds": 300,
    "ChallengeRetentionHours": 24,
    "ChallengeCleanupIntervalMinutes": 10,
    "ChallengeRateLimitPerMinute": 10,
    "CompleteRateLimitPerMinute": 10,
    "WriteRateLimitPerMinute": 30
  },
  "Retention": {
    "NotificationRetentionDays": 180,
    "EmailOutboxRetentionDays": 30,
    "CleanupIntervalMinutes": 10,
    "BatchSize": 2000
  },
  "Health": {
    "EmailBacklogWarningThreshold": 50,
    "MediaCleanupBacklogWarningThreshold": 100,
    "DeviceChallengeBacklogWarningThreshold": 100,
    "CopyDedupeBacklogWarningThreshold": 1000,
    "ModerationTaskBacklogWarningThreshold": 100
  },
  "Operations": {
    "Backup": {
      "StatusFilePath": ""
    }
  },
  "PublicSite": {
    "BaseUrl": ""
  },
  "ViewCounter": {
    "DedupeSecret": "",
    "DedupeWindowSeconds": 600
  },
  "CopyCounter": {
    "DedupeSecret": "",
    "BucketSeconds": 600,
    "DedupeTtlSeconds": 720,
    "RateLimitPerMinute": 60
  },
  "Email": {
    "Provider": "Smtp",
    "PublicBaseUrl": "",
    "SiteName": "WhalePod（鲸群）",
    "SuppressionHashSecret": "",
    "UnsubscribeSecret": "",
    "UnsubscribeTokenLifetimeDays": 30,
    "PollIntervalSeconds": 30,
    "BatchSize": 20,
    "LeaseSeconds": 300,
    "MaxAttempts": 5,
    "BackoffBaseSeconds": 60,
    "BackoffMaxSeconds": 3600,
    "Smtp": {
      "Host": "",
      "Port": 587,
      "Security": "StartTls",
      "FromAddress": "",
      "FromName": "WhalePod",
      "TimeoutSeconds": 30
    }
  },
  "Account": {
    "GitHubHmacBlacklistEnabled": false
  },
  "MediaStorage": {
    "Provider": "S3",
    "PublicBaseUrl": "",
    "CleanupIntervalMinutes": 60,
    "CleanupBatchSize": 100,
    "S3": {
      "ServiceUrl": "",
      "BucketName": "",
      "Region": "ap-guangzhou",
      "ForcePathStyle": true
    }
  },
  "ReverseProxy": {
    "ForwardedHeadersEnabled": false,
    "KnownProxies": [],
    "KnownNetworks": [],
    "ForwardLimit": 1
  },
  "GitHub": {
    "ClientId": "",
    "ClientSecret": "",
    "AuthorizeEndpoint": "https://github.com/login/oauth/authorize",
    "TokenEndpoint": "https://github.com/login/oauth/access_token",
    "UserEndpoint": "https://api.github.com/user",
    "EmailEndpoint": "https://api.github.com/user/emails",
    "OrganizationsEndpoint": "https://api.github.com/user/orgs",
    "AllowedLogins": [],
    "AllowedOrganizations": [],
    "CallbackPath": "/auth/github/callback"
  }
}
