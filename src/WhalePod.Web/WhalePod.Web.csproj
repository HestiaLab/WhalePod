<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\WhalePod.Contracts\WhalePod.Contracts.csproj" />
    <ProjectReference Include="..\WhalePod.Domain\WhalePod.Domain.csproj" />
    <ProjectReference Include="..\WhalePod.Infrastructure\WhalePod.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pin the SDK's implicit static-web-assets pack so lock files are portable across SDK installs. -->
    <PackageReference Include="Microsoft.AspNetCore.App.Internal.Assets" Version="10.0.14" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

</Project>
