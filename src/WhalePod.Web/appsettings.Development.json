{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "WhalePod": "Host=127.0.0.1;Port=55432;Database=whalepod;Username=postgres"
  },
  "Auth": {
    "DevLoginEnabled": true,
    "BootstrapAdminHandles": [
      "alice"
    ]
  },
  "Audit": {
    "IpHashSecret": "dev-only-audit-ip-hash-secret-change-me"
  },
  "MediaStorage": {
    "Provider": "Local",
    "PublicBaseUrl": "/media"
  },
  "PublicSite": {
    "BaseUrl": "http://localhost:5224"
  },
  "PublicSearch": {
    "RateLimitPerMinute": 30,
    "TimeoutSeconds": 3
  },
  "Email": {
    "Provider": "Logging",
    "PublicBaseUrl": "http://localhost:5224",
    "SuppressionHashSecret": "dev-only-email-suppression-secret-change-me",
    "UnsubscribeSecret": "dev-only-email-unsubscribe-secret-change-me"
  },
  "Account": {
    "GitHubHmacBlacklistEnabled": false
  },
  "CopyCounter": {
    "DedupeSecret": "dev-only-copy-counter-secret-change-me",
    "BucketSeconds": 600,
    "DedupeTtlSeconds": 720,
    "RateLimitPerMinute": 100000
  },
  "ViewCounter": {
    "DedupeSecret": "dev-only-view-counter-secret-change-me",
    "DedupeWindowSeconds": 600
  }
}
