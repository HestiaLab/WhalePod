{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ApiWriteRateLimit": {
    "PermitLimit": 60,
    "WindowSeconds": 60
  },
  "ApiUploadRateLimit": {
    "PermitLimit": 20,
    "WindowSeconds": 60
  },
  "ApiRequestLimits": {
    "MaxJsonBodyBytes": 8388608,
    "MaxImageUploadRequestBytes": 11534336
  },
  "AgentRateLimit": {
    "ReadPerMinute": 120,
    "WritePerMinute": 60,
    "HeartbeatPerMinute": 12
  },
  "DeviceVerification": {
    "MaxActiveDevices": 5,
    "ChallengeTtlSeconds": 300,
    "TimestampSkewSeconds": 300,
    "MaxFailedAttempts": 5,
    "FailureWindowSeconds": 600,
    "LockoutSeconds": 300,
    "ChallengeRetentionHours": 24,
    "ChallengeCleanupIntervalMinutes": 10,
    "ChallengeRateLimitPerMinute": 10,
    "CompleteRateLimitPerMinute": 10,
    "WriteRateLimitPerMinute": 30
  },
  "Retention": {
    "NotificationRetentionDays": 180,
    "EmailOutboxRetentionDays": 30,
    "CleanupIntervalMinutes": 10,
    "BatchSize": 2000
  },
  "Email": {
    "Provider": "Smtp",
    "PublicBaseUrl": "",
    "SiteName": "WhalePod（鲸群）",
    "SuppressionHashSecret": "",
    "UnsubscribeSecret": "",
    "UnsubscribeTokenLifetimeDays": 30,
    "PollIntervalSeconds": 30,
    "BatchSize": 20,
    "LeaseSeconds": 300,
    "MaxAttempts": 5,
    "BackoffBaseSeconds": 60,
    "BackoffMaxSeconds": 3600,
    "Smtp": {
      "Host": "",
      "Port": 587,
      "Security": "StartTls",
      "FromAddress": "",
      "FromName": "WhalePod",
      "TimeoutSeconds": 30
    }
  },
  "Account": {
    "GitHubHmacBlacklistEnabled": false
  },
  "MediaStorage": {
    "Provider": "S3",
    "PublicBaseUrl": "",
    "CleanupIntervalMinutes": 60,
    "CleanupBatchSize": 100,
    "S3": {
      "ServiceUrl": "",
      "BucketName": "",
      "Region": "ap-guangzhou",
      "ForcePathStyle": true
    }
  },
  "ReverseProxy": {
    "ForwardedHeadersEnabled": false,
    "KnownProxies": [],
    "KnownNetworks": [],
    "ForwardLimit": 1
  }
}
